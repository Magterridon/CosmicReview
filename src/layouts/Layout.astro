---
import "../styles/global.css";
import "../styles/chalk.css";
import "../styles/projet.css";
import "../styles/partenaires.css";
import "../styles/carnet.css";
import "../styles/gemeaux.css";

interface Props {
  title: string;
  description: string;
  scene: string;
}

const { title, description, scene } = Astro.props;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <meta name="theme-color" content="#04050c" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <!-- Jost pour le site, Caveat pour l'écriture d'Arthur dans le carnet.
         `display=swap` : si Caveat n'arrive pas, la pile de repli manuscrite
         de `carnet.css` prend le relais sans faire attendre la page. -->
    <link
      href="https://fonts.googleapis.com/css2?family=Jost:wght@300;400;500&family=Caveat:wght@400;600&display=swap"
      rel="stylesheet"
    />

    <!-- Le ciel et le logotype sont visibles dès la première image ; le
         monde à la craie attend juste derrière, prêt pour la transition. -->
    <link rel="preload" as="image" href="/sky.webp" />
    <link rel="preload" as="image" href="/cosmic-logo.webp" />
  </head>

  <!-- `data-scene` fixe la scène de départ : elle est rendue active dès le
       HTML, donc la bonne scène s'affiche même sans JavaScript. -->
  <body data-scene={scene}>
    <slot />

    <!-- Le son est coupé par défaut dans tous les navigateurs tant qu'on n'a
         rien cliqué ; ce bouton reste le seul endroit où le couper ensuite,
         quelle que soit la scène. Son état (`aria-pressed`) est peint par
         `audio.js`, qui retient aussi le choix d'une visite à l'autre. -->
    <button type="button" class="son-toggle" data-son aria-pressed="true" aria-label="Couper le son d'ambiance">
      <svg class="son-icon son-icon--on" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <path d="M4 9v6h4l5 5V4L8 9H4Z" />
        <path d="M16.5 8.5a5 5 0 0 1 0 7" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
        <path d="M19 6a8.5 8.5 0 0 1 0 12" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
      </svg>
      <svg class="son-icon son-icon--off" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <path d="M4 9v6h4l5 5V4L8 9H4Z" />
        <path d="M16 9.5 21 14.5M21 9.5 16 14.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
      </svg>
    </button>

    <script>
      import "../scripts/main.js";
    </script>
  </body>
</html>
